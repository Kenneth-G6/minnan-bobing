# 仓库内统一使用 LF 换行
* text=auto eol=lf

# 二进制资源不做换行转换
*.woff2 binary
*.woff binary
*.ttf binary
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.pdf binary

# Windows 脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 语言统计时排除
package-lock.json linguist-generated=true
docs/screenshots/* linguist-documentation=true
